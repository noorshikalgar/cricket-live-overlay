# mock | cricketliveapi | sportmonks
CRICKET_PROVIDER=mock
CRICKET_API_KEY=
# Hard caps: the server never sends more than this (free plan: 100/day, 5/min)
DAILY_CALL_LIMIT=100
RATE_LIMIT_PER_MINUTE=5
# Override the provider's base URL (from your API dashboard docs)
CRICKET_API_BASE_URL=https://cricketliveapi.com/api/v1
# Fixed poll interval in seconds (0 = spread the daily budget over a whole match).
# Testing on the free plan: 60 → ~3 calls/min → about 30 minutes of live data per day.
POLL_SECONDS=60
# Never poll faster than this (seconds)
MIN_POLL_SECONDS=3
PORT=4300
# Mock provider: seconds per ball in the replay
MOCK_BALL_SECONDS=3
# Optional obs-websocket bridge (phase 4)
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
OBS_WEBCAM_SOURCE=Webcam
