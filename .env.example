# mock | cricketliveapi | sportmonks
CRICKET_PROVIDER=mock
CRICKET_API_KEY=
# Plan's daily call limit (CricketLiveApi Pro = 5000)
DAILY_CALL_LIMIT=5000
# Never poll faster than this (seconds)
MIN_POLL_SECONDS=3
PORT=4300
# Mock provider: seconds per ball in the replay
MOCK_BALL_SECONDS=3
# Optional obs-websocket bridge (phase 4)
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
OBS_WEBCAM_SOURCE=Webcam
