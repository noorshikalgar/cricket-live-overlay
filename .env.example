# Data provider: mock (no key, replays a demo match) | cricketliveapi | sportmonks
CRICKET_PROVIDER=mock
# Your provider token (never commit it; .env is gitignored)
CRICKET_API_KEY=
CRICKET_API_BASE_URL=https://cricketliveapi.com/api/v1

# Hard API limits: the server never sends more calls than this.
# CricketLiveApi free plan: 100 per day, 5 per minute.
DAILY_CALL_LIMIT=100
RATE_LIMIT_PER_MINUTE=5

# Seconds between score updates. 0 = spread the daily limit across a whole match.
# Free plan testing: 60 (about 1.5 hours of live data per day).
POLL_SECONDS=60
# Never poll faster than this
MIN_POLL_SECONDS=3

# Server port (OBS Browser Source URL uses it)
PORT=4300

# Mock provider: seconds per ball in the demo replay
MOCK_BALL_SECONDS=3

# Optional: let the app move your OBS webcam into the camera frame (OBS 28+, Tools → WebSocket Server Settings)
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
OBS_WEBCAM_SOURCE=Webcam
