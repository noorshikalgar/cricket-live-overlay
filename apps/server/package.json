{
  "name": "@cos/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/main.ts --dev",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "record": "tsx scripts/generate-recording.ts",
    "probe": "tsx --env-file-if-exists=../../.env scripts/probe.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "obs-websocket-js": "^5.0.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cos/shared": "*",
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
